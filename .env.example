GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ADMIN_TELEGRAM_IDS=
CRON_SECRET=
APP_ENV=development
REPORTS_DIR=./reportes_generados
