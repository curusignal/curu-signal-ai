# Obligatorio en producción
TELEGRAM_BOT_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
DATABASE_URL=sqlite:///./curu_dev.db
PUBLIC_BASE_URL=https://tu-dominio.example

# Configuración comercial
PRECIO_SUSCRIPCION_COP=30000
DURACION_SUSCRIPCION_DIAS=30
# Catálogo opcional por país: el cliente elige el mercado al comprar.
# Cada mercado necesita importe y moneda compatibles con la cuenta/proveedor de cobro.
# Ejemplo: CURU_PRICE_CATALOG={"CO":{"label":"Colombia","currency":"COP","amount":"30000"}}

# Operación
TIMEZONE=America/Bogota
LOG_LEVEL=INFO
REPORT_HOUR=4
REPORT_MINUTE=0
CURU_MIN_COVERAGE=0.70
CURU_MIN_DOLLAR_VOLUME=10000000

# IA opcional: contextualiza métricas técnicas del Top 10 y noticias; no calcula métricas ni probabilidades
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ADMIN_TELEGRAM_IDS=
CRON_SECRET=
APP_ENV=development
REPORTS_DIR=./reportes_generados
